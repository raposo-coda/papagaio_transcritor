[Unit]
Description=Papagaio Transcritor - sincroniza com o GitHub e reconstroi
Documentation=https://github.com/raposo-coda/papagaio_transcritor
After=papagaio.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/container-data
AssertPathIsMountPoint=/mnt/container-data

[Service]
Type=oneshot
EnvironmentFile=/etc/default/papagaio
ExecStart=/usr/local/lib/papagaio/deploy.sh sync
# Uma transcricao local usa a maquina inteira. O deploy pode esperar: cede CPU
# e disco para nao travar quem estiver usando o aplicativo nesse momento.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600

[Install]
WantedBy=timers.target
